# Lanka Offers web (Next.js). Copy to .env.local and adjust.

# Public API base URL. Leave unset to call same-origin /api/*, which next.config.mjs
# rewrites to https://api.lanka-offers.me.
NEXT_PUBLIC_API_URL=https://api.lanka-offers.me

# OpenStreetMap-format tile server for the nearby map.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
