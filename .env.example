# Lanka Offers Web Frontend Environment Configuration
# Copy this file to .env and set appropriate values

# Backend API Base URL (leave empty to use Vite dev proxy in local development)
VITE_API_BASE_URL=https://api.lanka-offers.me

# Map Tile Server URL (OpenStreetMap tile format)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
